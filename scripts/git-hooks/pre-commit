#!/usr/bin/env bash
#
# FairMediator pre-commit hook.
# Blocks: high-confidence secrets, AI watermarks (attribution footers +
# zero-width unicode markers), documentation drift, vulnerable axios.
#
# Installed via `git config core.hooksPath scripts/git-hooks` (npm "prepare").
# Override a single commit with: git commit --no-verify
#
set -uo pipefail

fail=0
red() { printf '\033[31m%s\033[0m\n' "$1"; }

# Only the lines being ADDED in this commit. The hooks dir is excluded so the
# pattern strings inside these hooks don't match themselves.
added="$(git diff --cached --no-color -U0 -- . ':(exclude)scripts/git-hooks/' \
          | grep '^+' | grep -v '^+++' || true)"

# 1. High-confidence secrets.
secret_re='AKIA[0-9A-Z]{16}|sk_live_[0-9a-zA-Z]{16,}|sk-[A-Za-z0-9]{20,}|re_[A-Za-z0-9]{16,}|hf_[A-Za-z0-9]{16,}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
if printf '%s' "$added" | grep -nE "$secret_re" >/dev/null 2>&1; then
  red "✗ pre-commit: possible secret in staged changes:"
  printf '%s' "$added" | grep -nE "$secret_re" | sed 's/^/    /'
  fail=1
fi

# 2. AI watermarks — attribution footers.
wm_re='Generated with \[?Claude|Co-[Aa]uthored-[Bb]y: *Claude|Written by Claude|via Claude Code|Generated by (an )?AI'
if printf '%s' "$added" | grep -nE "$wm_re" >/dev/null 2>&1; then
  red "✗ pre-commit: AI watermark / attribution in staged changes:"
  printf '%s' "$added" | grep -nE "$wm_re" | sed 's/^/    /'
  fail=1
fi

# 3. AI watermarks — zero-width / invisible unicode (steganographic markers).
#    (BSD grep has no -P, so use perl, which ships with macOS.)
if printf '%s' "$added" \
   | perl -CSD -ne 'BEGIN{$f=0} $f=1 if /[\x{200b}\x{200c}\x{200d}\x{2060}\x{feff}]/; END{exit($f)}'; then
  : # no invisible chars
else
  red "✗ pre-commit: zero-width/invisible unicode (AI watermark) in staged changes."
  fail=1
fi

# Locate the repo root that holds scripts/ — works both from the public repo
# and from the nested internal/ repo (which sits inside the public worktree).
if [ -f scripts/doc-swarm/detect.js ]; then ROOT="."
elif [ -f ../scripts/doc-swarm/detect.js ]; then ROOT=".."
else ROOT=""; fi

# 4. Documentation drift (free, deterministic).
if [ -n "$ROOT" ]; then
  if ! ( cd "$ROOT" && node scripts/doc-swarm/detect.js >/dev/null 2>&1 ); then
    red "✗ pre-commit: documentation drift — run 'npm run docs:detect' to see details."
    fail=1
  fi
fi

# 5. Vulnerable axios guard (reuse the existing checker).
if [ -n "$ROOT" ] && [ -f "$ROOT/scripts/check-axios-version.js" ]; then
  if ! ( cd "$ROOT" && node scripts/check-axios-version.js >/dev/null 2>&1 ); then
    red "✗ pre-commit: blocked axios version detected."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  red "Commit blocked. Fix the above, or bypass once with: git commit --no-verify"
  exit 1
fi
exit 0
