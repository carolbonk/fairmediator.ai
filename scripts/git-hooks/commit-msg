#!/usr/bin/env bash
#
# FairMediator commit-msg hook.
# Rejects: AI watermarks/attribution and emoji in the commit message.
# Override once with: git commit --no-verify
#
set -uo pipefail

msg_file="$1"
msg="$(cat "$msg_file")"
fail=0
red() { printf '\033[31m%s\033[0m\n' "$1"; }

# AI attribution / watermarks in the message.
if printf '%s' "$msg" \
   | grep -nE 'Generated with \[?Claude|Co-[Aa]uthored-[Bb]y: *Claude|Written by Claude|via Claude Code|Generated by (an )?AI' >/dev/null 2>&1; then
  red "✗ commit-msg: remove AI watermark/attribution from the commit message."
  fail=1
fi

# No emoji in commit messages.
if printf '%s' "$msg" \
   | perl -CSD -ne 'BEGIN{$f=0} $f=1 if /[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{FE0F}\x{2B50}\x{2B55}]/; END{exit($f)}'; then
  : # no emoji
else
  red "✗ commit-msg: no emoji in commit messages."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  red "Commit message rejected. Edit it, or bypass once with: git commit --no-verify"
  exit 1
fi
exit 0
